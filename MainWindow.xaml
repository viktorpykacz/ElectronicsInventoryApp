<Window x:Class="ElectronicsInventoryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InventoryApp"
        Height="500" Width="1200">

    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Top">
            <Button x:Name="BtnAdd" Content="Dodaj" Margin="8,0,0,0" Click="BtnAdd_Click" />
            <Button x:Name="BtnEdit" Content="Edytuj" Margin="8,0,0,0" Click="BtnEdit_Click" />
            <Button x:Name="BtnDelete" Content="Usuń" Margin="8,0,0,0" Click="BtnDelete_Click" />
            <Button x:Name="BtnImport" Content="Importuj" Margin="20,0,0,0" Click="BtnImport_Click" />
            <Button x:Name="BtnExport" Content="Eksportuj" Margin="8,0,0,0" Click="BtnExport_Click" />
        </StackPanel>

        <DataGrid x:Name="DataGridComponents"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="10"
                  MouseDoubleClick="DataGridComponents_MouseDoubleClick"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="🖋️ Edytuj" Click="MenuItem_Edit_Click"/>
                    <MenuItem Header="🗑️ Usuń" Click="MenuItem_Delete_Click"/>
                    <Separator/>
                    <MenuItem Header="🔍 Szczegóły" Click="MenuItem_Details_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="Auto" />
                <DataGridTextColumn Header="Producent" Binding="{Binding Manufacturer}" Width="Auto" />
                <DataGridTextColumn Header="Nr katalogowy producenta" Binding="{Binding PartNumber}" Width="Auto" />
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="Auto" />
                <DataGridTextColumn Header="Kategoria" Binding="{Binding CategoryPath}" Width="Auto" />
                <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
