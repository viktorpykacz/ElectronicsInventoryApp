<Window x:Class="ElectronicsInventoryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InventoryApp" Height="600" Width="900">

    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Top">
            <TextBox Width="300" Margin="0,0,8,0" x:Name="SearchBox" HorizontalAlignment="Left" />
            <Button x:Name="BtnSearch" Content="Szukaj" Click="BtnSearch_Click" />
            <Button x:Name="BtnAdd" Content="Dodaj" Margin="8,0,0,0" Click="BtnAdd_Click" />
            <Button x:Name="BtnEdit" Content="Edytuj" Margin="8,0,0,0" Click="BtnEdit_Click" />
            <Button x:Name="BtnDelete" Content="Usuń" Margin="8,0,0,0" Click="BtnDelete_Click" />
        </StackPanel>

        <DataGrid x:Name="DataGridComponents"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="10"
                  MouseDoubleClick="DataGridComponents_MouseDoubleClick">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="🖋️ Edytuj" Click="MenuItem_Edit_Click"/>
                    <MenuItem Header="🗑️ Usuń" Click="MenuItem_Delete_Click"/>
                    <Separator/>
                    <MenuItem Header="🔍 Szczegóły" Click="MenuItem_Details_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Producent" Binding="{Binding Manufacturer}" Width="*" />
                <DataGridTextColumn Header="Numer części" Binding="{Binding PartNumber}" Width="*" />
                <DataGridTextColumn Header="Opis" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn Header="Ilość" Binding="{Binding Quantity}" Width="Auto" />
            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>
</Window>
