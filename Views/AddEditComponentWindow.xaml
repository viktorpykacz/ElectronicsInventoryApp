<Window x:Class="ElectronicsInventoryApp.Views.AddEditComponentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dodaj / Edytuj element" Height="Auto" Width="500">
    <StackPanel Margin="10">
        <TextBlock Text="Nazwa"/>
        <TextBox x:Name="NameBox" Margin="0,5,0,10"/>
        <TextBlock Text="Producent"/>
        <TextBox x:Name="ManufacturerBox" Margin="0,5,0,10"/>
        <TextBlock Text="Nr katalogowy producenta"/>
        <TextBox x:Name="PartNumberBox" Margin="0,5,0,10"/>
        <TextBlock Text="Opis"/>
        <TextBox x:Name="DescriptionBox" Margin="0,5,0,10"/>
        <TextBlock Text="Kategoria"/>
        <ComboBox x:Name="CategoryBox" Margin="0,5,0,10" SelectionChanged="CategoryBox_SelectionChanged"/>
        <TextBlock Text="Podkategoria"/>
        <ComboBox x:Name="SubCategoryBox" Margin="0,5,0,10" SelectionChanged="SubCategoryBox_SelectionChanged" IsEnabled="False"/>
        <TextBlock Text="Rodzaj"/>
        <ComboBox x:Name="SubSubCategoryBox" Margin="0,5,0,10" IsEnabled="False"/>
        <TextBlock Text="Ilość"/>
        <TextBox x:Name="QuantityBox" Margin="0,5,0,10"/>
        <TextBlock Text="URL"/>
        <TextBox x:Name="DatasheetUrlBox" Margin="0,5,0,10"/>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Zapisz"
                    Width="100"
                    Height="40"
                    HorizontalAlignment="Left"
                    Click="Save_Click"/>

            <Button Grid.Column="1"
                    Content="Anuluj"
                    Width="100"
                    Height="40"
                    HorizontalAlignment="Right"
                    Click="Cancel_Click"/>
        </Grid>
    </StackPanel>
</Window>