<Window x:Class="ElectronicsInventoryApp.Views.AddEditComponentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Dodaj / Edytuj element" Height="467" Width="400">
    <StackPanel Margin="10">
        <TextBlock Text="Nazwa:"/>
        <TextBox x:Name="NameBox" Margin="0,5,0,10"/>
        <TextBlock Text="Producent:"/>
        <TextBox x:Name="ManufacturerBox" Margin="0,5,0,10"/>
        <TextBlock Text="Numer katalogowy:"/>
        <TextBox x:Name="PartNumberBox" Margin="0,5,0,10"/>
        <TextBlock Text="Opis:"/>
        <TextBox x:Name="DescriptionBox" Margin="0,5,0,10"/>
        <TextBlock Text="Kategoria:"/>
        <ComboBox x:Name="CategoryBox" Margin="0,5,0,10"/>
        <TextBlock Text="Ilość:"/>
        <TextBox x:Name="QuantityBox" Margin="0,5,0,10"/>
        <TextBlock Text="Tagi:"/>
        <TextBox x:Name="TagsBox" Margin="0,5,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Zapisz" Width="86" Click="Save_Click" Height="40"/>
            <Button Content="Anuluj" Width="90" Click="Cancel_Click" Height="40"/>
        </StackPanel>
    </StackPanel>
</Window>